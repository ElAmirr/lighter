generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  username         String             @unique
  email            String             @unique
  password_hash    String
  avatar_url       String?
  created_at       DateTime           @default(now())
  
  lighters         Lighter[]          @relation("CurrentOwner")
  history_entries  OwnershipHistory[] @relation("PreviousOwner")
  stolen_entries   OwnershipHistory[] @relation("StolenFrom")
  scans            Scan[]
  push_subscriptions PushSubscription[]
}

model Collection {
  id        String    @id @default(uuid())
  name      String    @unique
  image_url String?
  lighters  Lighter[]
}

model Rarity {
  id        String    @id @default(uuid())
  name      String    @unique
  xp_reward Int       @default(0)
  lighters  Lighter[]
}

model Lighter {
  id               String             @id @default(uuid())
  name             String
  collection_id    String
  rarity_id        String
  image_url        String?
  current_owner_id String?
  scan_count       Int                @default(0)
  created_at       DateTime           @default(now())

  collection       Collection         @relation(fields: [collection_id], references: [id])
  rarity           Rarity             @relation(fields: [rarity_id], references: [id])
  current_owner    User?              @relation("CurrentOwner", fields: [current_owner_id], references: [id])
  history_entries  OwnershipHistory[]
  scans            Scan[]
}

model OwnershipHistory {
  id               String             @id @default(uuid())
  lighter_id       String
  owner_id         String
  captured_at      DateTime           @default(now())
  latitude         Float?
  longitude        Float?
  city_name        String             @default("Unknown")
  message          String?
  stolen_from_id   String?

  lighter          Lighter            @relation(fields: [lighter_id], references: [id])
  owner            User               @relation("PreviousOwner", fields: [owner_id], references: [id])
  stolen_from      User?              @relation("StolenFrom", fields: [stolen_from_id], references: [id])
}

model Scan {
  id               String             @id @default(uuid())
  lighter_id       String
  user_id          String?
  scanned_at       DateTime           @default(now())
  latitude         Float?
  longitude        Float?

  lighter          Lighter            @relation(fields: [lighter_id], references: [id])
  user             User?              @relation(fields: [user_id], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  user_id   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  created_at DateTime @default(now())

  user      User     @relation(fields: [user_id], references: [id])
}

model LevelConfig {
  id          Int      @id @default(autoincrement())
  level       Int      @unique
  xp_required Int
  title       String   @default("Street Hunter")
  created_at  DateTime @default(now())
}

model DailyMission {
  id          String   @id @default("daily") // Singleton ID
  title       String   @default("Capture 3 different lighters")
  description String   @default("Find and scan 3 unique lighters across the city.")
  goal_type   String   @default("captures") // e.g. 'captures', 'scans', 'cities'
  goal_count  Int      @default(3)
  xp_reward   Int      @default(250)
  reward_label String  @default("Rare Sticker")
  updated_at  DateTime @updatedAt
}

model AchievementConfig {
  id          Int      @id @default(autoincrement())
  title       String   @default("Achievement")
  icon        String   @default("Zap") 
  color       String   @default("#FFD60A")
  goal_type   String   @default("captures") // e.g., 'captures', 'cities', 'rarity'
  goal_count  Int      @default(1)
  goal_string String?  @default("") // For rarity, comma separated list maybe, or single rarity
  created_at  DateTime @default(now())
}
